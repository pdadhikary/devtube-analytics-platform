# DevTube Analytics Platform Configuration
YOUTUBE_API_BASE=https://www.googleapis.com/youtube/v3
YOUTUBE_API_KEY=SECRET
TRANSCRIPT_LANGS='["en"]'
TRANSCRIPT_SOURCES='["manual", "auto"]'
TRANSCRIPT_REQUEST_DELAY_SECONDS=10
TRANSCRIPT_MAX_RETRIES=2
TRANSCRIPT_RETRY_BACKOFF_SECONDS=60
TRANSCRIPT_RETRY_PASS_COOLDOWN_SECONDS=120
TRANSCRIPT_COOKIES_FROM_BROWSER=firefox
TRANSCRIPT_COOKIES_PROFILE=/path/to/firefox/profile
VIDEO_WINDOWS_DAYS=7
MAX_VIDEOS_PER_CHANNEL=15
COMMENT_THREADS_PER_VIDEO=30
VIDEO_LIMIT=500
MAX_VIDEO_DURATION_SECONDS=2700
SHORTS_MAX_DURATION_SECONDS=90

# AWS Configuration
AWS_ENDPOINT_URL=http://localhost:9000
AWS_DEFAULT_REGION=ap-south-1
AWS_ACCESS_KEY_ID=admin
AWS_SECRET_ACCESS_KEY=password123

# qdrant Configuration
QDRANT_SECRET_KEY=password123

# rustfs Configuration
S3_ENDPOINT_URL=localhost:9000

# Terraform Provider Configuration
TF_VAR_aws_endpoint_url=http://localhost:9000

# S3 Configuration
TF_VAR_s3_bucket_name=devtube-lakehouse

# Dagster Database Secrets
DAGSTER_DB_USER=admin
DAGSTER_DB_PASSWORD=password123
DAGSTER_DB_NAME=dagster_db

# TZ Only for Dagster and UI usage, databases will always use UTC
TZ=Asia/Dhaka
