# YoutTube Data API V3
YOUTUBE_API_KEY=SECRET

# AWS Configuration
AWS_ENDPOINT_URL=http://localhost:9000
AWS_DEFAULT_REGION=ap-south-1
AWS_ACCESS_KEY_ID=Admin
AWS_SECRET_ACCESS_KEY=Admin123

# qdrant Configuration
QDRANT_SECRET_KEY=Admin123

# rustfs Configuration
S3_ENDPOINT_URL=localhost:9000

# Terraform Provider Configuration
TF_VAR_aws_endpoint_url=http://localhost:9000

# S3 Configuration
TF_VAR_s3_bucket_name=devtube-lakehouse

# Dagster Database Secrets
DAGSTER_DB_USER=Admin
DAGSTER_DB_PASSWORD=Admin123
DAGSTER_DB_NAME=dagster_db

# Polaris Database Secrets
POLARIS_CLIENT_ID=Admin
POLARIS_CLIENT_SECRET=Admin123
POLARIS_DB_USER=Admin
POLARIS_DB_PASSWORD=Admin123
POLARIS_DB_NAME=polaris_db

TZ=Asia/Dhaka
